# MagentaStation service. ApplyConfig exits 75 when structural changes are
# staged; systemd restarts it with the same config. Clean shutdown exits 0.
#
# Adjust User/Group/paths for your deployment. Install to
# /etc/systemd/system/magentastation.service, then:
#   systemctl daemon-reload && systemctl enable --now magentastation

[Unit]
Description=TETRA MagentaStation MS stack
After=network.target

[Service]
Type=simple
# Path to the magentastation binary and the MS TOML config it should load.
ExecStart=/usr/local/bin/magentastation /etc/magentastation/config-ms.toml
# Default log verbosity. The stack logs via `tracing`; steady-state runs quiet at
# `info` (registration/call/cell events + warnings/errors only). Bump on demand
# for troubleshooting — e.g. `RUST_LOG=debug` (per-PDU decodes) or `RUST_LOG=trace`
# (per-frame/per-burst firehose), or target one module: `RUST_LOG=tetra_entities::mm=debug`.
Environment=RUST_LOG=info
# Treat EXIT_RESTART (75) as a restart trigger for the config-apply flow, and
# also restart on unexpected failures. A clean exit (0) stops the service.
Restart=on-failure
RestartForceExitStatus=75
RestartSec=1
# A clean Ctrl+C / management shutdown is SIGINT (exit 0, not restarted).
KillSignal=SIGINT

# Receive-timed processing benefits from predictable scheduling. Adjust FIFO
# priority and CPU affinity for this machine; see docs/MS_CONFIG.md.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=73
# Give real-time I/O priority to the SDR/USB reads as well.
IOSchedulingClass=realtime
IOSchedulingPriority=0
# Fallback niceness for any non-RT helper threads.
Nice=-10
# Limits for RT priority and optional memory locking.
LimitRTPRIO=99
LimitMEMLOCK=infinity
# Example for a four-core host: radio on 2-3, UI on 0-1. Adjust to the CPU count.
CPUAffinity=2 3

# Recommended hardening / RF device access — tune for your SDR and user.
# SoapySDR/USB device access typically needs the process to reach /dev/bus/usb.
# User=magentastation
# Group=plugdev

[Install]
WantedBy=multi-user.target
